{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-demo",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "DB_PATH=data/demo.sqlite .venv/bin/uvicorn api.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
