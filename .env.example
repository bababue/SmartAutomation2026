# Team settings: copy to .env (git-ignored) and fill in the key. All variables: README → Configuration.

# Claude Haiku 5.5 via OpenRouter for pipeline runs and web uploads.
OPENROUTER_API_KEY=sk-or-...
LLM_BACKEND=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=${OPENROUTER_API_KEY}
CLASSIFY_MODEL=anthropic/claude-haiku-5.5
EXTRACT_MODEL=anthropic/claude-haiku-5.5
